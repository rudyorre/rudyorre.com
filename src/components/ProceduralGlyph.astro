---
interface Props {
  seed: string;
  size?: 'sm' | 'md' | 'banner';
  icon?:
    | 'brewin'
    | 'tensorfaux'
    | 'dashviz'
    | 'chatbot'
    | 'vit'
    | 'postagger'
    | 'ngram'
    | 'linreg'
    | 'cppptr';
  image?: string;
  alt?: string;
}

const { seed, size = 'sm', icon, image, alt = '' } = Astro.props;

// Deterministic FNV-1a 32-bit hash + SplitMix32 stream for rich procedural geometry
function hash(str: string): number {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function makeRng(seedStr: string) {
  let state = hash(seedStr) || 1;
  return () => {
    state = (state + 0x9e3779b9) >>> 0;
    let z = state;
    z = Math.imul(z ^ (z >>> 16), 0x85ebca6b) >>> 0;
    z = Math.imul(z ^ (z >>> 13), 0xc2b2ae35) >>> 0;
    return ((z ^ (z >>> 16)) >>> 0) / 4294967296;
  };
}

const h0 = hash(seed);
const variant = h0 % 5;

const accents = [
  'var(--glyph-accent-1)',
  'var(--glyph-accent-2)',
  'var(--glyph-accent-3)',
  'var(--glyph-accent-4)',
  'var(--glyph-accent-5)',
];
const accent = accents[(h0 >>> 3) % accents.length];
const accentSecondary = accents[((h0 >>> 3) + 2) % accents.length];

const w = size === 'banner' ? 640 : 64;
const h = size === 'banner' ? 140 : 64;
const cx = w / 2;
const cy = h / 2;
const scale = size === 'banner' ? 1.85 : 1;

// Precompute geometry per variant so markup stays clean
const rng = makeRng(seed);

// Variant 0: Orbital phase system (nested rotated ellipses + Lissajous arc + satellite nodes)
const orbits = Array.from({ length: 3 }).map((_, i) => {
  const rx = (18 - i * 3.5) * scale;
  const ry = (7.5 + rng() * 5) * scale;
  const rot = Math.round(rng() * 150 - 75);
  const theta = rng() * Math.PI * 2;
  const rad = (rot * Math.PI) / 180;
  const px = rx * Math.cos(theta);
  const py = ry * Math.sin(theta);
  const sx = cx + px * Math.cos(rad) - py * Math.sin(rad);
  const sy = cy + px * Math.sin(rad) + py * Math.cos(rad);
  return { rx, ry, rot, sx, sy, dashed: i === 1 };
});

// Variant 1: Stacked topographic / Fourier ridge horizon
const ridgeCount = size === 'banner' ? 7 : 6;
const ridges = Array.from({ length: ridgeCount }).map((_, idx) => {
  const yBase = (h * 0.2) + (idx / (ridgeCount - 1)) * (h * 0.62);
  const freq1 = 1.5 + rng() * 2.0;
  const freq2 = 3.0 + rng() * 2.5;
  const phase1 = rng() * Math.PI * 2;
  const phase2 = rng() * Math.PI * 2;
  const peakX = 0.22 + rng() * 0.56;
  const steps = size === 'banner' ? 40 : 20;
  const pts: string[] = [];
  for (let s = 0; s <= steps; s++) {
    const t = s / steps;
    const x = t * w;
    const env = Math.exp(-Math.pow((t - peakX) / 0.24, 2));
    const dy =
      (Math.sin(t * Math.PI * freq1 + phase1) * 6.5 +
        Math.cos(t * Math.PI * freq2 + phase2) * 3.2) *
      env *
      scale;
    pts.push(`${s === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${(yBase - dy).toFixed(1)}`);
  }
  const d = pts.join(' ');
  const areaD = `${d} L ${w} ${h} L 0 ${h} Z`;
  const isAccent = idx === Math.floor(ridgeCount / 2);
  return { d, areaD, isAccent, opacity: (0.35 + (idx / ridgeCount) * 0.6).toFixed(2) };
});

// Variant 2: Constellation / Delaunay-style mesh graph
const nodeCount = size === 'banner' ? 14 : 8;
const meshNodes = Array.from({ length: nodeCount }).map((_, i) => {
  const angle = (i / nodeCount) * Math.PI * 2 + (rng() - 0.5) * 0.55;
  const radius = (0.18 + rng() * 0.62) * (size === 'banner' ? h * 0.44 : 23);
  const spreadX = size === 'banner' ? 3.2 : 1;
  return {
    x: cx + Math.cos(angle) * radius * spreadX,
    y: cy + Math.sin(angle) * radius,
    hub: i < 2,
  };
});
const meshEdges: { x1: number; y1: number; x2: number; y2: number; primary: boolean }[] = [];
for (let i = 0; i < meshNodes.length; i++) {
  for (let j = i + 1; j < meshNodes.length; j++) {
    const dx = (meshNodes[i].x - meshNodes[j].x) / (size === 'banner' ? 2.2 : 1);
    const dy = meshNodes[i].y - meshNodes[j].y;
    const dist = Math.hypot(dx, dy);
    if (dist < (size === 'banner' ? 42 : 24)) {
      meshEdges.push({
        x1: meshNodes[i].x,
        y1: meshNodes[i].y,
        x2: meshNodes[j].x,
        y2: meshNodes[j].y,
        primary: meshNodes[i].hub || meshNodes[j].hub,
      });
    }
  }
}

// Variant 3: Isometric stacked planes + signal bus (triggered by post:rebuilding-this-site)
const isoLayers = [-1, 0, 1].map((offset, idx) => {
  const yCenter = cy + offset * (size === 'banner' ? 14 : 8.5);
  const rx = (size === 'banner' ? 54 : 19) - idx * 1.5;
  const ry = (size === 'banner' ? 18 : 8.5) - idx * 0.5;
  const points = [
    `${cx},${yCenter - ry}`,
    `${cx + rx},${yCenter}`,
    `${cx},${yCenter + ry}`,
    `${cx - rx},${yCenter}`,
  ].join(' ');
  return { points, yCenter, rx, ry, isMiddle: offset === 0, isTop: offset === -1 };
});
const isoRot = Math.round((rng() - 0.5) * 16);

// Variant 4: Radial polar sonar / harmonic burst
const spokeCount = size === 'banner' ? 28 : 16;
const spokes = Array.from({ length: spokeCount }).map((_, i) => {
  const a = (i / spokeCount) * Math.PI * 2;
  const rInner = (5 + (i % 2) * 3) * scale;
  const rOuter = (11 + rng() * 13) * scale;
  return {
    x1: cx + Math.cos(a) * rInner,
    y1: cy + Math.sin(a) * rInner,
    x2: cx + Math.cos(a) * rOuter,
    y2: cy + Math.sin(a) * rOuter,
    highlight: i % 5 === h0 % 5,
  };
});
---

<div class={`glyph-frame glyph-${size}`} aria-hidden={alt ? undefined : 'true'}>
  {
    image ? (
      <img src={image} alt={alt} loading="lazy" decoding="async" />
    ) : icon ? (
      <svg
        viewBox="0 0 64 64"
        xmlns="http://www.w3.org/2000/svg"
        class="glyph-svg"
      >
        <rect width="64" height="64" fill="var(--glyph-bg)" />
        <g stroke="var(--glyph-grid)" stroke-width="1">
          <line x1="0" y1="32" x2="64" y2="32" />
          <line x1="32" y1="0" x2="32" y2="64" />
        </g>

        {icon === 'brewin' && (
          <g style="--glyph-accent: #0ea5e9;">
            <path
              d="M 22 33 L 42 33 L 39.5 49 L 24.5 49 Z"
              fill="var(--glyph-accent)"
              fill-opacity="0.18"
              stroke="var(--glyph-accent)"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
            <path
              d="M 25 27 C 22.5 23.5, 27.5 20.5, 25 16.5"
              fill="none"
              stroke="var(--glyph-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <path
              d="M 32 27 C 29.5 23.5, 34.5 20.5, 32 16.5"
              fill="none"
              stroke="var(--glyph-accent)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
            <path
              d="M 39 27 C 36.5 23.5, 41.5 20.5, 39 16.5"
              fill="none"
              stroke="var(--glyph-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </g>
        )}

        {icon === 'tensorfaux' && (
          <g style="--glyph-accent: #f59e0b;" stroke-linejoin="round">
            <polygon
              points="32,13 49,25 43,47 21,47 15,25"
              fill="var(--glyph-accent)"
              fill-opacity="0.16"
              stroke="var(--glyph-accent)"
              stroke-width="1.5"
            />
            <line x1="32" y1="13" x2="29" y2="33" stroke="var(--glyph-accent)" stroke-width="1.2" />
            <line x1="49" y1="25" x2="29" y2="33" stroke="var(--glyph-accent)" stroke-width="1.2" />
            <line x1="43" y1="47" x2="29" y2="33" stroke="var(--glyph-accent)" stroke-width="1.2" />
            <line x1="21" y1="47" x2="29" y2="33" stroke="var(--glyph-ink)" stroke-width="1.1" opacity="0.7" />
            <line x1="15" y1="25" x2="29" y2="33" stroke="var(--glyph-ink)" stroke-width="1.1" opacity="0.7" />
            <circle cx="29" cy="33" r="2.2" fill="var(--glyph-accent)" />
          </g>
        )}

        {icon === 'dashviz' && (
          <g style="--glyph-accent: #10b981;">
            <rect x="16" y="36" width="6" height="12" rx="1" fill="var(--glyph-ink)" opacity="0.35" />
            <rect x="25" y="29" width="6" height="19" rx="1" fill="var(--glyph-ink)" opacity="0.55" />
            <rect x="34" y="33" width="6" height="15" rx="1" fill="var(--glyph-ink)" opacity="0.45" />
            <rect x="43" y="21" width="6" height="27" rx="1" fill="var(--glyph-accent)" opacity="0.85" />
            <polyline
              points="19,31 28,23 37,26 46,16"
              fill="none"
              stroke="var(--glyph-accent)"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="46" cy="16" r="2.2" fill="var(--glyph-accent)" />
          </g>
        )}

        {icon === 'chatbot' && (
          <g style="--glyph-accent: #3b82f6;">
            <rect
              x="14"
              y="18"
              width="36"
              height="28"
              rx="4"
              fill="var(--glyph-bg)"
              stroke="var(--glyph-ink)"
              stroke-width="1.4"
              opacity="0.85"
            />
            <polyline
              points="21,28 26,32 21,36"
              fill="none"
              stroke="var(--glyph-accent)"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <line
              x1="30"
              y1="36"
              x2="41"
              y2="36"
              stroke="var(--glyph-accent)"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </g>
        )}

        {icon === 'vit' && (
          <g style="--glyph-accent: #8b5cf6;">
            {[0, 1, 2].map((r) =>
              [0, 1, 2].map((c) => {
                const isCenter = r === 1 && c === 1;
                const isCorner = r === 0 && c === 2;
                return (
                  <rect
                    x={16 + c * 11.5}
                    y={16 + r * 11.5}
                    width="9"
                    height="9"
                    rx="1.5"
                    fill={isCenter || isCorner ? 'var(--glyph-accent)' : 'none'}
                    fill-opacity={isCenter ? '0.85' : isCorner ? '0.28' : '0'}
                    stroke={isCenter || isCorner ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                    stroke-width="1.3"
                    opacity={isCenter || isCorner ? '1' : '0.55'}
                  />
                );
              })
            )}
          </g>
        )}

        {icon === 'postagger' && (
          <g style="--glyph-accent: #ec4899;">
            {[18, 32, 46].map((x, idx) => (
              <g>
                <rect
                  x={x - 5.5}
                  y="18"
                  width="11"
                  height="8"
                  rx="2"
                  fill={idx === 1 ? 'var(--glyph-accent)' : 'none'}
                  fill-opacity={idx === 1 ? '0.2' : '0'}
                  stroke={idx === 1 ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                  stroke-width="1.4"
                />
                <line
                  x1={x}
                  y1="26"
                  x2={x}
                  y2="41"
                  stroke={idx === 1 ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                  stroke-width="1.4"
                />
                <circle
                  cx={x}
                  cy="44"
                  r="2.2"
                  fill={idx === 1 ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                />
              </g>
            ))}
          </g>
        )}

        {icon === 'ngram' && (
          <g style="--glyph-accent: #14b8a6;">
            <circle cx="19" cy="36" r="5" fill="none" stroke="var(--glyph-ink)" stroke-width="1.4" />
            <circle cx="32" cy="22" r="5" fill="none" stroke="var(--glyph-ink)" stroke-width="1.4" />
            <circle
              cx="45"
              cy="36"
              r="5.5"
              fill="var(--glyph-accent)"
              fill-opacity="0.22"
              stroke="var(--glyph-accent)"
              stroke-width="1.6"
            />
            <line x1="23" y1="32" x2="28" y2="26" stroke="var(--glyph-ink)" stroke-width="1.3" />
            <line x1="36" y1="26" x2="41" y2="32" stroke="var(--glyph-accent)" stroke-width="1.5" />
            <line x1="24" y1="36" x2="39" y2="36" stroke="var(--glyph-accent)" stroke-width="1.3" stroke-dasharray="2 2" />
          </g>
        )}

        {icon === 'linreg' && (
          <g style="--glyph-accent: #f97316;">
            <line
              x1="15"
              y1="47"
              x2="49"
              y2="17"
              stroke="var(--glyph-accent)"
              stroke-width="1.7"
              stroke-linecap="round"
            />
            <circle cx="19" cy="40" r="2" fill="var(--glyph-ink)" opacity="0.75" />
            <circle cx="25" cy="43" r="2" fill="var(--glyph-ink)" opacity="0.75" />
            <circle cx="29" cy="31" r="2" fill="var(--glyph-ink)" opacity="0.75" />
            <circle cx="36" cy="33" r="2" fill="var(--glyph-ink)" opacity="0.75" />
            <circle cx="40" cy="21" r="2" fill="var(--glyph-ink)" opacity="0.75" />
            <circle cx="45" cy="25" r="2" fill="var(--glyph-accent)" />
          </g>
        )}

        {icon === 'cppptr' && (
          <g style="--glyph-accent: #6366f1;">
            <line x1="32" y1="23" x2="20" y2="41" stroke="var(--glyph-ink)" stroke-width="1.4" />
            <line x1="32" y1="23" x2="44" y2="41" stroke="var(--glyph-accent)" stroke-width="1.5" />
            <circle
              cx="32"
              cy="20"
              r="5"
              fill="var(--glyph-accent)"
              fill-opacity="0.22"
              stroke="var(--glyph-accent)"
              stroke-width="1.6"
            />
            <circle cx="20" cy="43" r="4.5" fill="var(--glyph-bg)" stroke="var(--glyph-ink)" stroke-width="1.4" />
            <circle cx="44" cy="43" r="4.5" fill="var(--glyph-bg)" stroke="var(--glyph-accent)" stroke-width="1.5" />
          </g>
        )}
      </svg>
    ) : (
      /* Fallback: Deterministic procedural generator from seed */
      <svg
        viewBox={`0 0 ${w} ${h}`}
        xmlns="http://www.w3.org/2000/svg"
        class="glyph-svg"
        style={`--glyph-accent: ${accent}; --glyph-accent-alt: ${accentSecondary};`}
      >
        <rect width={w} height={h} fill="var(--glyph-bg)" />

        {/* Subtle technical registration grid + corner ticks */}
        <g stroke="var(--glyph-grid)" stroke-width="1">
          <line x1="0" y1={cy} x2={w} y2={cy} />
          <line x1={cx} y1="0" x2={cx} y2={h} />
          {size === 'banner' && (
            <>
              <line x1={w * 0.25} y1="0" x2={w * 0.25} y2={h} />
              <line x1={w * 0.75} y1="0" x2={w * 0.75} y2={h} />
            </>
          )}
          <circle cx={cx} cy={cy} r={22 * scale} fill="none" stroke-dasharray="2 3" />
        </g>

        {variant === 0 && (
          /* Motif 0: Orbital phase system (tilted ellipses + satellite nodes) */
          <g fill="none">
            {orbits.map((o, idx) => (
              <g>
                <ellipse
                  cx={cx}
                  cy={cy}
                  rx={o.rx}
                  ry={o.ry}
                  transform={`rotate(${o.rot} ${cx} ${cy})`}
                  stroke={idx === 0 ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                  stroke-width={idx === 0 ? '1.4' : '1.05'}
                  stroke-dasharray={o.dashed ? '3 2.5' : undefined}
                  opacity={idx === 0 ? '0.95' : '0.55'}
                />
                <circle
                  cx={o.sx}
                  cy={o.sy}
                  r={idx === 0 ? '2.4' : '1.7'}
                  fill={idx === 0 ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                />
              </g>
            ))}
            <circle cx={cx} cy={cy} r={3 * scale} fill="var(--glyph-accent)" fill-opacity="0.22" stroke="var(--glyph-accent)" stroke-width="1.3" />
          </g>
        )}

        {variant === 1 && (
          /* Motif 1: Stacked Fourier / Joy Division horizon ridges */
          <g>
            {ridges.map((r) => (
              <g>
                <path d={r.areaD} fill="var(--glyph-bg)" opacity="0.85" />
                <path
                  d={r.d}
                  fill="none"
                  stroke={r.isAccent ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                  stroke-width={r.isAccent ? '1.6' : '1.05'}
                  opacity={r.isAccent ? '1' : r.opacity}
                />
              </g>
            ))}
          </g>
        )}

        {variant === 2 && (
          /* Motif 2: Constellation / Delaunay network mesh */
          <g>
            {meshEdges.map((e) => (
              <line
                x1={e.x1}
                y1={e.y1}
                x2={e.x2}
                y2={e.y2}
                stroke={e.primary ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                stroke-width={e.primary ? '1.25' : '0.95'}
                opacity={e.primary ? '0.75' : '0.38'}
              />
            ))}
            {meshNodes.map((n) => (
              <circle
                cx={n.x}
                cy={n.y}
                r={n.hub ? '2.7' : '1.8'}
                fill={n.hub ? 'var(--glyph-accent)' : 'var(--glyph-bg)'}
                stroke={n.hub ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                stroke-width="1.3"
              />
            ))}
          </g>
        )}

        {variant === 3 && (
          /* Motif 3: Isometric stacked system planes + vertical bus */
          <g transform={`rotate(${isoRot} ${cx} ${cy})`} stroke-linejoin="round">
            {/* Vertical alignment pillars connecting bottom & top planes */}
            <line
              x1={cx - isoLayers[0].rx}
              y1={isoLayers[0].yCenter}
              x2={cx - isoLayers[2].rx}
              y2={isoLayers[2].yCenter}
              stroke="var(--glyph-ink)"
              stroke-width="1"
              stroke-dasharray="2 2"
              opacity="0.45"
            />
            <line
              x1={cx + isoLayers[0].rx}
              y1={isoLayers[0].yCenter}
              x2={cx + isoLayers[2].rx}
              y2={isoLayers[2].yCenter}
              stroke="var(--glyph-ink)"
              stroke-width="1"
              stroke-dasharray="2 2"
              opacity="0.45"
            />

            {/* Bottom, Middle (accent), and Top isometric planes */}
            {isoLayers
              .slice()
              .reverse()
              .map((layer) => (
                <g>
                  <polygon
                    points={layer.points}
                    fill={layer.isMiddle ? 'var(--glyph-accent)' : 'var(--glyph-bg)'}
                    fill-opacity={layer.isMiddle ? '0.2' : '0.82'}
                    stroke={layer.isMiddle ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                    stroke-width={layer.isMiddle ? '1.5' : '1.15'}
                  />
                  {layer.isTop && (
                    /* Inner subdivision crosslines on top plane */
                    <g stroke="var(--glyph-ink)" stroke-width="0.9" opacity="0.55">
                      <line
                        x1={cx - layer.rx * 0.5}
                        y1={layer.yCenter - layer.ry * 0.5}
                        x2={cx + layer.rx * 0.5}
                        y2={layer.yCenter + layer.ry * 0.5}
                      />
                      <line
                        x1={cx + layer.rx * 0.5}
                        y1={layer.yCenter - layer.ry * 0.5}
                        x2={cx - layer.rx * 0.5}
                        y2={layer.yCenter + layer.ry * 0.5}
                      />
                    </g>
                  )}
                </g>
              ))}

            {/* Central spine & active core nodes */}
            <line
              x1={cx}
              y1={isoLayers[0].yCenter - 4}
              x2={cx}
              y2={isoLayers[2].yCenter + 4}
              stroke="var(--glyph-accent)"
              stroke-width="1.5"
            />
            <circle cx={cx} cy={isoLayers[0].yCenter} r="2.3" fill="var(--glyph-accent)" />
            <circle cx={cx} cy={isoLayers[1].yCenter} r="2.6" fill="var(--glyph-bg)" stroke="var(--glyph-accent)" stroke-width="1.5" />
          </g>
        )}

        {variant === 4 && (
          /* Motif 4: Polar harmonic burst / sonar dial */
          <g stroke-linecap="round">
            <circle
              cx={cx}
              cy={cy}
              r={14 * scale}
              fill="var(--glyph-accent)"
              fill-opacity="0.1"
              stroke="var(--glyph-accent)"
              stroke-width="1"
              stroke-dasharray="2 3"
            />
            {spokes.map((s) => (
              <line
                x1={s.x1}
                y1={s.y1}
                x2={s.x2}
                y2={s.y2}
                stroke={s.highlight ? 'var(--glyph-accent)' : 'var(--glyph-ink)'}
                stroke-width={s.highlight ? '1.6' : '1.15'}
                opacity={s.highlight ? '0.95' : '0.6'}
              />
            ))}
            <circle cx={cx} cy={cy} r={3.5 * scale} fill="var(--glyph-bg)" stroke="var(--glyph-accent)" stroke-width="1.5" />
          </g>
        )}
      </svg>
    )
  }
</div>
