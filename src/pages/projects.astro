---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProceduralGlyph from '../components/ProceduralGlyph.astro';
import { projects } from '../data/site';

const featuredProjects = projects.filter((p) => p.featured);
const archiveProjects = projects.filter((p) => !p.featured);
---

<BaseLayout
  title="Projects"
  description="Open-source libraries, systems tools, and software projects by Rudy Orre."
>
  <h1>Projects</h1>
  <p class="muted">
    Open-source libraries, systems tools, and earlier university research.
  </p>

  <div class="section-heading" style="margin-top: 1.75rem;">
    <span>Selected Systems & Libraries</span>
  </div>
  <ul class="media-list">
    {
      featuredProjects.map((project) => {
        const href = project.visit || project.source;
        const isExternal = href ? href.startsWith('http') : false;
        return (
          <li class="media-item">
            <a
              href={href || '/projects'}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
              class="media-thumb-link"
              tabindex="-1"
              aria-hidden="true"
            >
              <ProceduralGlyph seed={`proj:${project.title}`} icon={project.icon} image={project.image} size="md" />
            </a>
            <div class="media-body">
              <div class="stack-item-header">
                <span class="stack-item-title">
                  {project.source ? (
                    <a href={project.source} target="_blank" rel="noopener">
                      {project.title} ↗
                    </a>
                  ) : (
                    project.title
                  )}
                  {project.visit && (
                    <>
                      {' '}
                      <a
                        href={project.visit}
                        target={project.visit.startsWith('http') ? '_blank' : undefined}
                        rel={project.visit.startsWith('http') ? 'noopener' : undefined}
                        class="mono muted"
                        style="font-size: 0.78rem; font-weight: 400;"
                      >
                        [live]
                      </a>
                    </>
                  )}
                </span>
                <span class="stack-item-meta">{project.year}</span>
              </div>
              <p class="stack-item-desc">{project.description}</p>
              <div class="tag-row">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>

  <div class="section-heading" style="margin-top: 2.5rem;">
    <span>Earlier Coursework & Research (2021 — 2023)</span>
  </div>
  <ul class="media-list">
    {
      archiveProjects.map((project) => {
        const href = project.source || project.visit;
        const isExternal = href ? href.startsWith('http') : false;
        return (
          <li class="media-item">
            <a
              href={href || '/projects'}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
              class="media-thumb-link"
              tabindex="-1"
              aria-hidden="true"
            >
              <ProceduralGlyph seed={`proj:${project.title}`} icon={project.icon} image={project.image} size="md" />
            </a>
            <div class="media-body">
              <div class="stack-item-header">
                <span class="stack-item-title">
                  {project.source ? (
                    <a href={project.source} target="_blank" rel="noopener">
                      {project.title} ↗
                    </a>
                  ) : (
                    project.title
                  )}
                  {project.visit && (
                    <>
                      {' '}
                      <a
                        href={project.visit}
                        target={project.visit.startsWith('http') ? '_blank' : undefined}
                        rel={project.visit.startsWith('http') ? 'noopener' : undefined}
                        class="mono muted"
                        style="font-size: 0.78rem; font-weight: 400;"
                      >
                        [live]
                      </a>
                    </>
                  )}
                </span>
                <span class="stack-item-meta">{project.year}</span>
              </div>
              <p class="stack-item-desc">{project.description}</p>
              <div class="tag-row">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
