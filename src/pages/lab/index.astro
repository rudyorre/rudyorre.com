---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProceduralGlyph from '../../components/ProceduralGlyph.astro';

const tools = [
  {
    slug: 'glyphs',
    title: 'Procedural SVG Glyph Workbench',
    url: '/lab/glyphs',
    seed: 'post:procedural-glyphs',
    status: '10 motif families',
    description:
      'Interactive synthesizer and bit-level inspector for deterministic 64×64 badges and 640×140 banners generated via FNV-1a, Murmur3 avalanche mixing, and SplitMix32.',
    tags: ['svg', 'prng', 'geometry', 'design-systems'],
  },
  {
    slug: 'versions',
    title: 'Time Machine — Site Version Archive',
    url: '/versions',
    seed: 'version:v3',
    status: '5 snapshots · v0-alpha–v4',
    description:
      'Six years of rudyorre.com across five architectural eras—from the literal first HTML5 UP commit in Feb 2020 through Hugo Academic, Next.js, and Astro—mounted directly into the static deployment tree.',
    tags: ['archive', 'html5up', 'hugo', 'nextjs', 'astro'],
  },
];
---

<BaseLayout
  title="Lab"
  description="Interactive systems experiments, visualizers, and technical tools by Rudy Orre."
>
  <h1>Lab</h1>
  <p class="muted">
    Interactive visualizers, sandboxes, and browser-native companions to technical essays.
  </p>

  <ul class="media-list" style="margin-top: 1.75rem;">
    {
      tools.map((tool) => (
        <li class="media-item">
          <a href={tool.url} class="media-thumb-link" tabindex="-1" aria-hidden="true">
            <ProceduralGlyph seed={tool.seed} size="md" />
          </a>
          <div class="media-body">
            <div class="stack-item-header">
              <span class="stack-item-title">
                <a href={tool.url}>{tool.title}</a>
              </span>
              <span class="stack-item-meta">{tool.status}</span>
            </div>
            <p class="stack-item-desc">{tool.description}</p>
            <div class="tag-row">
              {tool.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
