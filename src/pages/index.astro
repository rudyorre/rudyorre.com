---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProceduralGlyph from '../components/ProceduralGlyph.astro';
import { getCollection } from 'astro:content';
import { projects, jobs, links } from '../data/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredProjects = projects.filter((p) => p.featured);

const formatDate = (date: Date) =>
  date.toISOString().slice(0, 10);
---

<BaseLayout>
  <section class="intro">
    <h1 class="intro-title">Rudy Orre</h1>
    <p>
      I'm a software engineer at <strong>Google</strong> working on the{' '}
      <strong>SecOps Detections Platform</strong>—building distributed systems
      for security event detection at scale.
    </p>
    <ul class="inline-links">
      <li><a href={links.github} target="_blank" rel="noopener">github ↗</a></li>
      <li><a href={links.linkedin} target="_blank" rel="noopener">linkedin ↗</a></li>
      <li><a href={links.email}>email</a></li>
    </ul>
  </section>

  <div class="section-heading">
    <span>Selected Projects</span>
    <a href="/projects">all projects →</a>
  </div>
  <ul class="media-list">
    {
      featuredProjects.map((project) => {
        const href = project.visit || project.source;
        const isExternal = href ? href.startsWith('http') : false;
        return (
          <li class="media-item">
            <a
              href={href || '/projects'}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
              class="media-thumb-link"
              tabindex="-1"
              aria-hidden="true"
            >
              <ProceduralGlyph seed={`proj:${project.title}`} icon={project.icon} image={project.image} size="sm" />
            </a>
            <div class="media-body">
              <div class="stack-item-header">
                <span class="stack-item-title">
                  {project.source ? (
                    <a href={project.source} target="_blank" rel="noopener">
                      {project.title} ↗
                    </a>
                  ) : (
                    project.title
                  )}
                  {project.visit && (
                    <>
                      {' '}
                      <a
                        href={project.visit}
                        target={project.visit.startsWith('http') ? '_blank' : undefined}
                        rel={project.visit.startsWith('http') ? 'noopener' : undefined}
                        class="mono muted"
                        style="font-size: 0.78rem; font-weight: 400;"
                      >
                        [live]
                      </a>
                    </>
                  )}
                </span>
                <span class="stack-item-meta">{project.tags.join(' · ')}</span>
              </div>
              <p class="stack-item-desc">{project.description}</p>
            </div>
          </li>
        );
      })
    }
  </ul>

  <div class="section-heading">
    <span>Blog</span>
    <a href="/blog">all posts →</a>
  </div>
  {
    posts.length > 0 ? (
      <ul class="media-list">
        {posts.map((post) => (
          <li class="media-item">
            <a href={`/blog/${post.id}`} class="media-thumb-link" tabindex="-1" aria-hidden="true">
              <ProceduralGlyph seed={`post:${post.id}`} image={post.data.image} size="sm" />
            </a>
            <div class="media-body">
              <div class="stack-item-header">
                <span class="stack-item-title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </span>
                <time class="post-date" datetime={formatDate(post.data.date)}>
                  {formatDate(post.data.date)}
                </time>
              </div>
              <p class="stack-item-desc">{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">No posts yet.</p>
    )
  }

  <div class="section-heading">
    <span>Experience</span>
  </div>
  <ul class="stack-list">
    {
      jobs.map((job) => (
        <li class="stack-item">
          <div class="stack-item-header">
            <span class="stack-item-title">
              {job.role} ·{' '}
              {job.companyUrl ? (
                <a href={job.companyUrl} target="_blank" rel="noopener">
                  {job.company}
                </a>
              ) : (
                job.company
              )}
            </span>
            <span class="stack-item-meta">{job.period}</span>
          </div>
          <p class="stack-item-desc">{job.summary}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
