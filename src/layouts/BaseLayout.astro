---
import '../styles/global.css';
import { links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  wide?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Rudy Orre',
  description = 'Software engineer at Google working on the SecOps Detections Platform.',
  canonical,
  wide = false,
  ogType = 'website',
  ogImage,
  publishedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://rudyorre.com');
const pageTitle = title === 'Rudy Orre' ? title : `${title} · Rudy Orre`;
const pathname = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(pathname, siteOrigin).toString();
const isActive = (prefix: string) =>
  prefix === '/' ? pathname === '/' : pathname.startsWith(prefix);

const cleanPath = pathname.replace(/^\/+|\/+$/g, '');
const knownOgPaths = new Set(['blog', 'projects', 'lab', 'lab/glyphs', 'versions']);
const defaultOgPath =
  !cleanPath
    ? '/og/default.png'
    : knownOgPaths.has(cleanPath) || cleanPath.startsWith('blog/')
      ? `/og/${cleanPath}.png`
      : '/og/default.png';
const ogImageUrl = new URL(ogImage ?? defaultOgPath, siteOrigin).toString();

const defaultJsonLd =
  pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://rudyorre.com/#website',
            url: 'https://rudyorre.com/',
            name: 'Rudy Orre',
            description,
            inLanguage: 'en-US',
          },
          {
            '@type': 'Person',
            '@id': 'https://rudyorre.com/#person',
            name: 'Rudy Orre',
            url: 'https://rudyorre.com/',
            jobTitle: 'Software Engineer',
            worksFor: {
              '@type': 'Organization',
              name: 'Google',
            },
            sameAs: [links.github, links.linkedin, links.twitter],
          },
        ],
      }
    : undefined;

const structuredData = jsonLd ?? defaultJsonLd;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Rudy Orre" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && <meta property="article:author" content="Rudy Orre" />}
    {ogType === 'article' &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23141413'/%3E%3Ctext x='16' y='21.5' text-anchor='middle' font-family='ui-monospace,SFMono-Regular,Menlo,monospace' font-size='15' font-weight='600' fill='%23ecebe6'%3Ero%3C/text%3E%3C/svg%3E"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Rudy Orre · RSS"
      href="/rss.xml"
    />
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    <script is:inline>
      (function () {
        try {
          var font = localStorage.getItem('ro-font');
          if (font === 'mono' || font === 'serif' || font === 'sans') {
            document.documentElement.setAttribute('data-font', font);
          }
          var theme = localStorage.getItem('ro-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="site-title">rudyorre<span>.com</span></a>
        <nav class="site-nav" aria-label="Primary">
          <ul class="nav-links">
            <li>
              <a
                href="/projects"
                aria-current={isActive('/projects') ? 'page' : undefined}
              >
                projects
              </a>
            </li>
            <li>
              <a
                href="/blog"
                aria-current={isActive('/blog') ? 'page' : undefined}
              >
                blog
              </a>
            </li>
            <li>
              <a
                href="/lab"
                aria-current={isActive('/lab') || isActive('/versions') ? 'page' : undefined}
              >
                lab
              </a>
            </li>
          </ul>
          <div class="toolbar">
            <button
              type="button"
              id="search-trigger"
              class="control-btn"
              aria-label="Search and commands (Command K or slash)"
              title="Search & commands (⌘K or /)"
            >
              <span>search</span>
              <kbd>⌘K</kbd>
            </button>
            <button
              type="button"
              id="theme-toggle"
              class="control-btn control-btn-icon"
              aria-label="Toggle color theme"
              title="Toggle light/dark theme"
            >
              <svg
                class="theme-icon theme-icon-sun"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
              </svg>
              <svg
                class="theme-icon theme-icon-moon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
              </svg>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <div class={wide ? 'container container-wide' : 'container'}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <span>© {new Date().getFullYear()} Rudy Orre</span>
        <div class="footer-right">
          <div class="font-switcher" role="group" aria-label="Font family">
            <button type="button" data-set-font="sans" class="font-chip">sans</button>
            <span>/</span>
            <button type="button" data-set-font="mono" class="font-chip">mono</button>
            <span>/</span>
            <button type="button" data-set-font="serif" class="font-chip">serif</button>
          </div>
          <span class="footer-sep" aria-hidden="true">·</span>
          <span>
            <a href={links.github} target="_blank" rel="noopener">github</a>
            {' · '}
            <a href={links.linkedin} target="_blank" rel="noopener">linkedin</a>
            {' · '}
            <a href="/rss.xml">rss</a>
            {' · '}
            <a href="/versions">time machine</a>
            {' · '}
            <a href={links.repo} target="_blank" rel="noopener" title="View site source on GitHub">
              source
            </a>
          </span>
        </div>
      </div>
    </footer>

    <dialog id="search-dialog" class="search-dialog" aria-label="Search and command palette">
      <div class="search-input-wrap">
        <span class="mono muted" aria-hidden="true">&gt;</span>
        <input
          id="search-input"
          class="search-input"
          type="search"
          placeholder="Search posts, projects, or commands…"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="go"
        />
        <button type="button" id="search-close" class="search-close-btn">
          esc
        </button>
      </div>
      <ul id="search-results" class="search-results" role="listbox"></ul>
      <div class="search-footer">
        <span class="search-footer-nav">↑↓ navigate · ↵ run / open</span>
        <span>type "font", "theme", or "v0"–"v3" for commands</span>
      </div>
    </dialog>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var fonts = ['sans', 'mono', 'serif'];

        function currentFont() {
          var f = root.getAttribute('data-font');
          return fonts.indexOf(f) !== -1 ? f : 'sans';
        }

        function setFont(next) {
          if (fonts.indexOf(next) === -1) return;
          root.setAttribute('data-font', next);
          try {
            localStorage.setItem('ro-font', next);
          } catch (_) {}
          updateFontChips();
        }

        function updateFontChips() {
          var active = currentFont();
          var chips = document.querySelectorAll('[data-set-font]');
          for (var i = 0; i < chips.length; i++) {
            var chip = chips[i];
            var isMatch = chip.getAttribute('data-set-font') === active;
            chip.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
          }
        }
        updateFontChips();

        document.addEventListener('click', function (e) {
          var target = e.target && e.target.closest ? e.target.closest('[data-set-font]') : null;
          if (target) {
            setFont(target.getAttribute('data-set-font'));
          }
        });

        // --- Theme state ---
        var themeBtn = document.getElementById('theme-toggle');

        function effectiveTheme() {
          var explicit = root.getAttribute('data-theme');
          if (explicit === 'light' || explicit === 'dark') return explicit;
          return window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }

        function setTheme(mode) {
          if (mode === 'system') {
            root.removeAttribute('data-theme');
            try {
              localStorage.removeItem('ro-theme');
            } catch (_) {}
          } else if (mode === 'light' || mode === 'dark') {
            root.setAttribute('data-theme', mode);
            try {
              localStorage.setItem('ro-theme', mode);
            } catch (_) {}
          }
          updateThemeLabel();
        }

        function updateThemeLabel() {
          if (!themeBtn) return;
          var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
          var label = 'Switch to ' + next + ' theme';
          themeBtn.setAttribute('aria-label', label);
          themeBtn.setAttribute('title', label);
        }
        updateThemeLabel();

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            setTheme(effectiveTheme() === 'dark' ? 'light' : 'dark');
          });
        }
        try {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', updateThemeLabel);
        } catch (_) {}

        // --- Built-in palette commands ---
        function getCommands() {
          var curFont = currentFont();
          var curTheme = effectiveTheme();
          return [
            {
              title: 'Font: Sans-serif (System UI)',
              snippet: (curFont === 'sans' ? 'Active · ' : '') + 'Switch body typography to clean system sans-serif',
              kind: 'command',
              body: 'font typography sans serif typeface style',
              run: function () { setFont('sans'); },
            },
            {
              title: 'Font: Monospace',
              snippet: (curFont === 'mono' ? 'Active · ' : '') + 'Switch body typography to technical monospace',
              kind: 'command',
              body: 'font typography mono monospace code terminal typeface style',
              run: function () { setFont('mono'); },
            },
            {
              title: 'Font: Serif',
              snippet: (curFont === 'serif' ? 'Active · ' : '') + 'Switch body typography to editorial serif',
              kind: 'command',
              body: 'font typography serif book editorial typeface style',
              run: function () { setFont('serif'); },
            },
            {
              title: 'Theme: Toggle Light / Dark',
              snippet: 'Currently ' + curTheme + ' — switch color mode',
              kind: 'command',
              body: 'theme dark light mode color appearance toggle',
              run: function () { setTheme(effectiveTheme() === 'dark' ? 'light' : 'dark'); },
            },
            {
              title: 'Theme: Dark Mode',
              snippet: 'Switch appearance to dark palette',
              kind: 'command',
              body: 'theme dark mode night color appearance',
              run: function () { setTheme('dark'); },
            },
            {
              title: 'Theme: Light Mode',
              snippet: 'Switch appearance to light palette',
              kind: 'command',
              body: 'theme light mode day color appearance',
              run: function () { setTheme('light'); },
            },
            {
              title: 'Theme: Use System Preference',
              snippet: 'Follow OS prefers-color-scheme setting',
              kind: 'command',
              body: 'theme system auto os preference reset',
              run: function () { setTheme('system'); },
            },
            {
              title: 'Time Machine: Launch v3.0 (2024–2025)',
              snippet: 'Open the archived Next.js 14 + Tailwind v3 site at /v3/',
              kind: 'command',
              body: 'time machine v3 2024 2025 archive history old version nextjs tailwind',
              run: function () { window.location.href = '/v3/'; },
            },
            {
              title: 'Time Machine: Launch v2.0 (2022–2023)',
              snippet: 'Open the archived Next.js + Styled Components v2 site at /v2/',
              kind: 'command',
              body: 'time machine v2 2022 2023 archive history old version nextjs styled components',
              run: function () { window.location.href = '/v2/'; },
            },
            {
              title: 'Time Machine: Launch v1.0 (2020–2021)',
              snippet: 'Open the archived Hugo Academic v1 site at /v1/',
              kind: 'command',
              body: 'time machine v1 2020 2021 archive history old version hugo academic',
              run: function () { window.location.href = '/v1/'; },
            },
            {
              title: 'Time Machine: Launch v0.0 (Sep 2020)',
              snippet: 'Open the archived HTML5 UP Spectral El Camino portfolio at /v0/',
              kind: 'command',
              body: 'time machine v0 2020 archive history old version html5up spectral',
              run: function () { window.location.href = '/v0/'; },
            },
            {
              title: 'Time Machine: Launch v0-alpha (Feb 10, 2020 First Commit)',
              snippet: 'Open the literal first commit with Lorem Ipsum at /v0-alpha/',
              kind: 'command',
              body: 'time machine v0-alpha 2020 first commit 3648bc8 lorem ipsum',
              run: function () { window.location.href = '/v0-alpha/'; },
            },
            {
              title: 'Time Machine: All Site Versions',
              snippet: 'Browse the full version history and architecture timeline (v0-alpha–v4)',
              kind: 'command',
              body: 'time machine versions archive history v0-alpha v0 v1 v2 v3 v4',
              run: function () { window.location.href = '/versions'; },
            },
          ];
        }

        // --- Search & Command Modal ---
        var dialog = document.getElementById('search-dialog');
        var trigger = document.getElementById('search-trigger');
        var closeBtn = document.getElementById('search-close');
        var input = document.getElementById('search-input');
        var list = document.getElementById('search-results');
        var indexCache = null;
        var indexPromise = null;
        var activeIdx = 0;
        var currentMatches = [];

        function syncViewport() {
          if (!dialog || !dialog.open || !window.visualViewport) return;
          var vv = window.visualViewport;
          dialog.style.setProperty('--vvh', vv.height + 'px');
          dialog.style.setProperty('--vvo', vv.offsetTop + 'px');
        }

        if (window.visualViewport) {
          window.visualViewport.addEventListener('resize', syncViewport);
          window.visualViewport.addEventListener('scroll', syncViewport);
        }

        function loadIndex() {
          if (indexCache) return Promise.resolve(indexCache);
          if (indexPromise) return indexPromise;
          indexPromise = fetch('/search-index.json')
            .then(function (r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            })
            .then(function (data) {
              indexCache = Array.isArray(data) ? data : [];
              return indexCache;
            })
            .catch(function () {
              indexPromise = null;
              return [];
            });
          return indexPromise;
        }

        function escapeHtml(s) {
          return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        function executeItem(item) {
          if (!item) return;
          closeSearch();
          if (typeof item.run === 'function') {
            item.run();
            return;
          }
          if (item.url) {
            if (item.url.indexOf('http') === 0) {
              window.open(item.url, '_blank', 'noopener');
            } else {
              window.location.href = item.url;
            }
          }
        }

        function renderResults(items, scrollActiveIntoView) {
          currentMatches = items;
          if (!list) return;
          if (!items.length) {
            list.innerHTML = '<li class="search-empty">No matching content or commands.</li>';
            list.scrollTop = 0;
            return;
          }
          if (activeIdx >= items.length) activeIdx = 0;
          list.innerHTML = items
            .map(function (item, idx) {
              var isCmd = item.kind === 'command';
              var href = isCmd ? '#' : escapeHtml(item.url);
              var ext = !isCmd && item.url && item.url.indexOf('http') === 0
                ? ' target="_blank" rel="noopener"'
                : '';
              return (
                '<li class="search-result-item" role="option" aria-selected="' +
                (idx === activeIdx ? 'true' : 'false') +
                '" data-idx="' +
                idx +
                '">' +
                '<a href="' +
                href +
                '"' +
                ext +
                ' data-item-idx="' +
                idx +
                '">' +
                '<span class="search-result-main">' +
                '<span class="search-result-title">' +
                escapeHtml(item.title) +
                '</span>' +
                '<span class="search-result-snippet">' +
                escapeHtml(item.snippet) +
                '</span>' +
                '</span>' +
                '<span class="search-result-kind' +
                (isCmd ? ' is-command' : '') +
                '">' +
                escapeHtml(item.kind) +
                '</span>' +
                '</a>' +
                '</li>'
              );
            })
            .join('');
          if (scrollActiveIntoView) {
            var activeEl = list.querySelector('[aria-selected="true"]');
            if (activeEl && activeEl.scrollIntoView) {
              activeEl.scrollIntoView({ block: 'nearest' });
            }
          } else {
            list.scrollTop = 0;
          }
        }

        if (list) {
          list.addEventListener('click', function (e) {
            var link = e.target && e.target.closest ? e.target.closest('[data-item-idx]') : null;
            if (!link) return;
            var idx = parseInt(link.getAttribute('data-item-idx'), 10);
            var item = currentMatches[idx];
            if (item && typeof item.run === 'function') {
              e.preventDefault();
              executeItem(item);
            } else {
              closeSearch();
            }
          });
        }

        function runQuery() {
          loadIndex().then(function (docs) {
            var q = input ? input.value : '';
            var commands = getCommands();
            var raw = q.trim();
            var cmdOnly = raw.charAt(0) === '>';
            var cleanQ = cmdOnly ? raw.slice(1).trim() : raw;
            var terms = cleanQ.toLowerCase().split(/\s+/).filter(Boolean);

            var pool = cmdOnly ? commands : docs.concat(commands);

            if (!terms.length) {
              activeIdx = 0;
              if (cmdOnly) {
                renderResults(commands, false);
              } else {
                // Default view: top content items + quick font/theme commands
                renderResults(docs.slice(0, 6).concat(commands.slice(0, 4)), false);
              }
              return;
            }

            var scored = [];
            for (var i = 0; i < pool.length; i++) {
              var d = pool[i];
              var hayTitle = d.title.toLowerCase();
              var haySnippet = d.snippet.toLowerCase();
              var hayBody = (d.body || '').toLowerCase();
              var score = 0;
              var matchedAll = true;
              for (var t = 0; t < terms.length; t++) {
                var term = terms[t];
                var inTitle = hayTitle.indexOf(term) !== -1;
                var inSnippet = haySnippet.indexOf(term) !== -1;
                var inBody = hayBody.indexOf(term) !== -1;
                if (!inTitle && !inSnippet && !inBody) {
                  matchedAll = false;
                  break;
                }
                if (inTitle) score += 10;
                if (inSnippet) score += 4;
                if (inBody) score += 2;
              }
              if (matchedAll) scored.push({ doc: d, score: score });
            }
            scored.sort(function (a, b) {
              return b.score - a.score;
            });
            activeIdx = 0;
            renderResults(
              scored.slice(0, 10).map(function (s) {
                return s.doc;
              }),
              false
            );
          });
        }

        function openSearch() {
          if (!dialog) return;
          if (!dialog.open) dialog.showModal();
          syncViewport();
          if (input) {
            input.value = '';
            input.focus();
          }
          runQuery();
        }

        function closeSearch() {
          if (dialog && dialog.open) dialog.close();
        }

        if (trigger) trigger.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);
        if (dialog) {
          dialog.addEventListener('click', function (e) {
            if (e.target === dialog) closeSearch();
          });
        }
        if (input) {
          input.addEventListener('input', runQuery);
          input.addEventListener('search', runQuery);
        }

        window.addEventListener('keydown', function (e) {
          var tag = (e.target && e.target.tagName) || '';
          var isInput =
            tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable);

          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (dialog && dialog.open) closeSearch();
            else openSearch();
            return;
          }

          if (!isInput && e.key === '/' && (!dialog || !dialog.open)) {
            e.preventDefault();
            openSearch();
            return;
          }

          if (dialog && dialog.open && currentMatches.length) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              activeIdx = (activeIdx + 1) % currentMatches.length;
              renderResults(currentMatches, true);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              activeIdx = (activeIdx - 1 + currentMatches.length) % currentMatches.length;
              renderResults(currentMatches, true);
            } else if (e.key === 'Enter') {
              var chosen = currentMatches[activeIdx];
              if (chosen) {
                e.preventDefault();
                executeItem(chosen);
              }
            }
          }
        });
      })();
    </script>
  </body>
</html>
